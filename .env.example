# Copy to .env to override docker-compose defaults, or export these when running locally.
# All values below are validated with zod at boot; the process exits on invalid config.

NODE_ENV=development
PORT=3001
# error | warn | info | http | debug
LOG_LEVEL=info

# Postgres / Redis (docker compose wires these automatically for the api service)
POSTGRES_PASSWORD=secure_auth_dev
DATABASE_URL=postgres://secure_auth:secure_auth_dev@localhost:5432/secure_auth
REDIS_URL=redis://localhost:6379/0

# Comma separated strict CORS allowlist. Empty = no cross-origin access.
CORS_ORIGINS=http://localhost:3000
# Express "trust proxy": false | true | <hop count> | loopback | CIDR list.
# Set it correctly behind a reverse proxy, otherwise rate limiting keys on the proxy IP.
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=15000

# Secrets provider: "file" reads one file per secret from SECRETS_DIR (Docker secrets layout;
# compose mounts ./secrets at /run/secrets), "env" reads SECRET_<NAME> variables (tests only).
# Generate the files with: npm run keygen
SECRETS_PROVIDER=file
SECRETS_DIR=./secrets

# JWT (RS256 or ES256, derived from each key). Private keys live in secrets named jwt_key_<kid>.
JWT_ISSUER=secure-auth-api
JWT_AUDIENCE=secure-auth-api-clients
JWT_ACTIVE_KID=k1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MFA_TOKEN_TTL_SECONDS=300
# Set to false for one access-token TTL when upgrading from a version without the at+jwt typ.
JWT_REQUIRE_TYP=true

# Envelope encryption. KEKs live in secrets named kek_<version>.
KEK_ACTIVE_VERSION=1

# HMAC root key for the keyed audit chain and recovery codes (secrets named mac_key_<version>).
MAC_ACTIVE_VERSION=1

# Password hashing: scrypt with N = 2^SCRYPT_LOG_N (memory per hash = 128 * N * r bytes).
# Production refuses SCRYPT_LOG_N < 14; tests use 10 for speed. Legacy bcrypt hashes are still
# verified and transparently upgraded on the next successful login.
SCRYPT_LOG_N=15
SCRYPT_R=8
SCRYPT_P=3

# Issuer label shown in authenticator apps
TOTP_ISSUER=SecureAuthAPI

RATE_LIMIT_ENABLED=true

# Admin seeded by the migrate service (idempotent). Change before exposing anywhere.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Admin-123!
