{
  "name": "secure-auth-api",
  "version": "1.0.0",
  "description": "Production-grade authentication API: RS256/JWKS, refresh rotation with reuse detection, TOTP 2FA, envelope encryption, hand-rolled rate limiting and a tamper-evident audit log.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "keygen": "tsx scripts/generate-secrets.ts",
    "reencrypt": "tsx --env-file=.env scripts/reencrypt.ts",
    "lint": "oxlint src scripts test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest -c jest.unit.config.js",
    "test:integration": "jest -c jest.integration.config.js --runInBand",
    "test:docker": "docker compose -f docker-compose.yml -f docker-compose.test.yml run --build --rm test"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.36",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "pg": "^8.16.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.7",
    "umzug": "^3.8.2",
    "winston": "^3.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@swc/core": "^1.11.0",
    "@swc/jest": "^0.2.38",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "oxlint": "^1.0.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.4",
    "typescript": "~5.9.2"
  }
}
